{
  "name": "@spiffdog-design/atlas-system",
  "private": true,
  "version": "1.0.0",
  "description": "Atlas Design System",
  "homepage": "https://github.com/Spiffdog-Design/Atlas#readme",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spiffdog-Design/Atlas.git"
  },
  "bugs": {
    "url": "https://github.com/Spiffdog-Design/Atlas/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.6.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=@spiffdog-design/atlas-*",
    "build:docs": "turbo run build --filter=docs",
    "dev": "turbo run dev --filter=docs --filter=@spiffdog-design/atlas-*",
    "lint": "turbo run lint",
    "format": "biome check --write .",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "turbo": "^2.10.2",
    "typescript": "5.9.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
