{
  "extends": "../typescript-config/react-library.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "outDir": "dist",
    "declarationDir": "types",
    "rootDir": "src",
    "module": "ES2022",
    "target": "ES2019",
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
