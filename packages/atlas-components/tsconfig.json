{
  "extends": "../typescript-config/react-library.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "src",
    "strictNullChecks": true,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "ignoreDeprecations": "5.0"
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
