{
  "name": "@spiffdog-design/atlas-components",
  "version": "0.0.0",
  "description": "Atlas Design System React components library",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.module.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js",
      "default": "./dist/button/index.js"
    },
    "./card": {
      "types": "./dist/card/index.d.ts",
      "import": "./dist/card/index.js",
      "default": "./dist/card/index.js"
    },
    "./code": {
      "types": "./dist/code/index.d.ts",
      "import": "./dist/code/index.js",
      "default": "./dist/code/index.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/index.d.ts",
      "import": "./dist/checkbox/index.js",
      "default": "./dist/checkbox/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "import": "./dist/input/index.js",
      "default": "./dist/input/index.js"
    },
    "./slider": {
      "types": "./dist/slider/index.d.ts",
      "import": "./dist/slider/index.js",
      "default": "./dist/slider/index.js"
    },
    "./progressbar": {
      "types": "./dist/progressbar/index.d.ts",
      "import": "./dist/progressbar/index.js",
      "default": "./dist/progressbar/index.js"
    },
    "./select": {
      "types": "./dist/select/index.d.ts",
      "import": "./dist/select/index.js",
      "default": "./dist/select/index.js"
    },
    "./radio-group": {
      "types": "./dist/radio-group/index.d.ts",
      "import": "./dist/radio-group/index.js",
      "default": "./dist/radio-group/index.js"
    },
    "./switch": {
      "types": "./dist/switch/index.d.ts",
      "import": "./dist/switch/index.js",
      "default": "./dist/switch/index.js"
    },
    "./tabs": {
      "types": "./dist/tabs/index.d.ts",
      "import": "./dist/tabs/index.js",
      "default": "./dist/tabs/index.js"
    },
    "./toast": {
      "types": "./dist/toast/index.d.ts",
      "import": "./dist/toast/index.js",
      "default": "./dist/toast/index.js"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "import": "./dist/dialog/index.js",
      "default": "./dist/dialog/index.js"
    },
    "./icon": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js",
      "default": "./dist/icons/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-styles.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "lint": "biome ci .",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@spiffdog-design/atlas-colors": "*",
    "@spiffdog-design/biome-config": "*",
    "@spiffdog-design/typescript-config": "*",
    "@storybook/react": "^8.6.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "jsdom": "^29.1.1",
    "storybook-addon-code-editor": "^4.1.2",
    "typescript": "5.9.2",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@spiffdog-design/atlas-tools": "*",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependencies": {
    "@spiffdog-design/atlas-colors": "*"
  }
}
